# Build-context exclusions for the backend image (context = repo root).
# Keeps the image small and prevents secrets / local envs from being shipped.

# Python virtualenvs & caches
**/__pycache__/
**/*.py[cod]
backend/.venv/
.venv/
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Frontend is built by its own Dockerfile (context = ./frontend)
frontend/

# Git, IDE, and documentation
.git/
.github/
.vscode/
.idea/
.kiro/
aidlc-docs/
docs/

# Environment & secrets — never bake into the image
.env
.env.*
!.env.example
*.pem
*.key

# Local SQLite databases
*.db
*.sqlite
*.sqlite3
data/*.db
