# ──────────────────────────────────────────────────────────────────────────────
# Kiro NRT Dashboard — Environment Variables Template
# Copy this file to .env and fill in real values.
# The .env file is NEVER committed to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── AWS credentials for S3 access (required) ──────────────────────────────────
AWS_ACCESS_KEY_ID=AKIA_REDACTED_KEY
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_DEFAULT_REGION=us-east-1

# ── JWT (required for production — change from the default!) ──────────────────
# Use a long random secret, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-chars
JWT_EXPIRY_MINUTES=720

# ── Database path (optional — defaults shown) ────────────────────────────────
# DATABASE_PATH=data/kiro_dashboard.db   # overridden by Docker Compose

# ── Cache TTLs in seconds (optional — defaults shown) ────────────────────────
# CACHE_TTL_SECONDS=300
# EMAIL_MAP_TTL_SECONDS=86400

# ── NRT refresh interval hint for frontend (seconds) ─────────────────────────
# REFRESH_INTERVAL_SECONDS=180

# ── AI Adoption score weights (optional — defaults shown) ────────────────────
# ADOPTION_WEIGHT_TOTAL_MESSAGES=0.40
# ADOPTION_WEIGHT_CHAT_CONVERSATIONS=0.30
# ADOPTION_WEIGHT_CREDITS_USED=0.20
# ADOPTION_WEIGHT_ACTIVE_DAYS=0.10
